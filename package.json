{
  "name": "schemaguard",
  "private": true,
  "version": "0.1.0",
  "description": "Visual schema builder + multi-DB SQL generator (MVP vertical slice)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "mcp": "tsx packages/mcp/src/index.ts",
    "mcp:http": "tsx packages/mcp/src/index.ts http",
    "mcp:start": "tsx packages/mcp/src/index.ts start",
    "mcp:stop": "tsx packages/mcp/src/index.ts stop",
    "mcp:status": "tsx packages/mcp/src/index.ts status",
    "typecheck": "tsc --noEmit && pnpm -C packages/core typecheck && pnpm -C packages/mcp typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -C packages/core test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/openai": "^3.0.73",
    "@dagrejs/dagre": "^3.0.0",
    "@schemaguard/core": "workspace:*",
    "@tauri-apps/api": "^2.1.1",
    "@xyflow/react": "^12.3.5",
    "ai": "^6.0.208",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11"
  },
  "packageManager": "pnpm@9.12.3"
}
